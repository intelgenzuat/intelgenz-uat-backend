# Copy this file to .env for local overrides. Never commit .env.
INTELGENZ_APP_NAME=Intelgenz API
INTELGENZ_APP_ENV=local
INTELGENZ_DEBUG=true
INTELGENZ_API_V1_PREFIX=/api/v1
INTELGENZ_MITRE_ATTACK_DATA_PATH=data/mitre_attack.json
# Shared PostgreSQL / Cloud SQL connection. Keep real credentials only in .env.
INTELGENZ_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelgenz
